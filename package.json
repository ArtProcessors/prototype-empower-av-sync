{
  "name": "empower-av-sync",
  "version": "0.0.0",
  "description": "Feasibility spike: a fixed 'screen' plays a looping video and acts as a permanent leader, continuously broadcasting its playback clock so joining phones keep their LOCAL audio tightly synced (clock-offset + playbackRate correction). Media is device-local; the wire carries only tiny sync beats.",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "start": "vite serve",
    "dev": "vite serve",
    "build": "tsc --noEmit && yarn worker:check && yarn test:check && vite build",
    "preview": "vite preview",
    "sim": "yarn sim:math && yarn sim:keep-awake",
    "sim:math": "node --import ./test/resolve-ts.mjs test/sync-sim.ts",
    "sim:keep-awake": "node --import ./test/resolve-ts.mjs test/keep-awake-sim.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:check": "tsc --noEmit -p worker/tsconfig.json",
    "test:check": "tsc --noEmit -p test/tsconfig.json",
    "worker:dev": "wrangler dev --port 8787",
    "deploy": "yarn build && wrangler deploy"
  },
  "dependencies": {
    "@trystero-p2p/core": "~0.25.3",
    "mp4box": "~2.4.1",
    "qrcode": "~1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "~5.20260826.1",
    "@types/qrcode": "~1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "~5.1.3",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "~7.3.1",
    "vite-plugin-pwa": "~1.2.0",
    "workbox-core": "~7.4.0",
    "workbox-expiration": "~7.4.0",
    "workbox-precaching": "~7.4.0",
    "workbox-range-requests": "~7.4.0",
    "workbox-routing": "~7.4.0",
    "workbox-strategies": "~7.4.0",
    "wrangler": "~4.126.0"
  }
}
