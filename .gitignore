# Large local-only media (real content). Regenerate from source with ffmpeg — see README.
# The small files in src/content/ ARE committed: primer.m4a is load-bearing (every
# follower loads it inside the unlock gesture), brand.mp4/.m4a are the default loop,
# and screen.mp4 is the diagnostic clip.
public/media/

# Yarn 4 (node-modules linker)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Sentry source-map upload credentials (@sentry/vite-plugin reads this file).
