{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The sims are run straight through Node's type-stripping (`node
    // test/sync-sim.ts`), which needs the extension in the specifier. Type
    // checking them therefore has to allow it — hence a project of their own
    // rather than adding `test` to the root include.
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["."]
}
